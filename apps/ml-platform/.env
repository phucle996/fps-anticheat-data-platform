# ==========================================
# ML Platform — Environment Configuration
# (Python ML Worker + Rust ONNX Inference + Go Gateway API)
# ==========================================

# Cấu hình Gateway API & IPC Socket Path
HTTP_PORT=8081
IPC_SOCKET_PATH=/tmp/rust_inference.sock
MODEL_ROOT=/app/models
MODEL_DIR=/app/models/current
POLICY_PATH=/app/config/ml-risk-policy.yml
INFERENCE_SESSION_POOL_SIZE=2
MODEL_RELOAD_INTERVAL_SECONDS=5
IPC_MAX_CONCURRENCY=128
IPC_MAX_REQUEST_BYTES=65536
PYTHONPATH=/app/python-ml-worker
PYTHONUNBUFFERED=1

# Cấu hình Kafka Event Bus
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_GOLD=pubg.v1.dataset.gold.ready
KAFKA_TOPIC_MODEL=pubg.v1.ml.model.ready
KAFKA_TOPIC_ML_DLQ=pubg.v1.ml.dlq
KAFKA_ML_GROUP_ID=python-ml-worker
ML_MAX_RETRIES=3

# Cấu hình MinIO S3 Object Storage & Model Registry
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_DATA=fps-anticheat-datalake
MINIO_BUCKET_MODEL=pubg-models
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
