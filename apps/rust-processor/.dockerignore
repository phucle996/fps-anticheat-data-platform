# Rust build artifacts — KHÔNG copy vào Docker build context
# Thư mục target chứa compiled artifacts rất nặng (hàng GB), cần exclude tuyệt đối
target/

# Git metadata — không cần thiết trong container
.git/
.gitignore

# File test và benchmark — chỉ cần trong CI, không cần trong runtime image
tests/
benches/

# Tài liệu — không ảnh hưởng binary
*.md
README*
LICENSE*
CHANGELOG*

# IDE và editor configs — không liên quan build
.idea/
.vscode/
*.swp
*.swo

# CI/CD configs — không cần trong container
.github/
.gitlab-ci.yml
Makefile
