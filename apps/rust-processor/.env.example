# ==========================================
# Rust Stream Processor — Environment Configuration
# PUBG Anti-Cheat Data Platform
# ==========================================

# Cấu hình Kafka Message Broker
KAFKA_BROKERS=kafka:9092
KAFKA_RAW_TOPIC=pubg.v1.kill-event.raw
KAFKA_GROUP_ID=rust-processor-group

# Cấu hình MinIO S3 Data Lake Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fps-anticheat-datalake

# Cấu hình Batching & Performance Tuning
BATCH_SIZE=1000
FLUSH_INTERVAL_MS=1000

# Cấu hình Log Level
RUST_LOG=info
