# ==========================================
# Environment Variables Example Configuration
# PUBG Anti-Cheat Data Platform
# ==========================================

# ------------------------------------------
# Environment & Application Settings
# ------------------------------------------
# Môi trường chạy ứng dụng: local | development | production
APP_ENV=local
# Mức độ ghi log: debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------
# Kaggle API Credentials (Go Dataset Sync)
# ------------------------------------------
# Username trên Kaggle của người dùng
KAGGLE_USERNAME=your_kaggle_username
# API Key của Kaggle (Tải từ Kaggle Account -> Create New Token)
KAGGLE_KEY=your_kaggle_api_key
# Dataset Slug từ Kaggle
KAGGLE_DATASET_SLUG=daniboy370/pubg-finish-placement-prediction
# Tên file CSV chính trong archive
KAGGLE_SELECTED_FILE=train_V2.csv

# ------------------------------------------
# Kafka Cluster Configuration
# ------------------------------------------
# Địa chỉ Kafka Broker kết nối (dạng comma-separated)
KAFKA_BROKERS=localhost:9092
# Topic phát dữ liệu hợp lệ (Raw Topic)
KAFKA_RAW_TOPIC=pubg.v1.player-stat.raw
# Topic phát dữ liệu lỗi (Invalid DLQ Topic)
KAFKA_INVALID_TOPIC=pubg.v1.invalid
# Consumer Group ID cho Rust Structured Streamer
KAFKA_CONSUMER_GROUP=pubg-anti-cheat-rust-structured-streamer
# Topic chứa tin nhắn sự kiện hợp lệ từ Go Replay
KAFKA_TOPIC_RAW=pubg.v1.player-stat.raw
# Topic Dead-Letter Queue chứa bản ghi lỗi validation / parse
KAFKA_TOPIC_INVALID=pubg.v1.invalid

# ------------------------------------------
# MinIO S3 Storage Configuration
# ------------------------------------------
# Endpoint kết nối MinIO S3 API
MINIO_ENDPOINT=http://localhost:9000
# MinIO Console Web UI Port
MINIO_CONSOLE_URL=http://localhost:9001
# Region mặc định cho MinIO
MINIO_REGION=us-east-1
# Access Key (Tài khoản MinIO)
MINIO_ACCESS_KEY=minioadmin
# Secret Key (Mật khẩu MinIO)
MINIO_SECRET_KEY=minioadmin
# Bucket chính chứa Data Lake
MINIO_BUCKET=pubg-data
# Có sử dụng kết nối bảo mật SSL/TLS không (false khi chạy local)
MINIO_USE_SSL=false

# ------------------------------------------
# Shiny Dashboard Configuration
# ------------------------------------------
# Host gán cho ứng dụng Web Shiny
SHINY_HOST=0.0.0.0
# Cổng chạy ứng dụng Web Shiny
SHINY_PORT=3838
