{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pubg-anticheat.org/schemas/batch-manifest.json",
  "title": "BatchManifest",
  "description": "Schema định nghĩa manifest cho từng Bronze Parquet batch do Rust Processor ghi xuống MinIO",
  "type": "object",
  "required": [
    "batch_id",
    "source_topic",
    "kafka_partition",
    "first_offset",
    "last_offset",
    "record_count",
    "valid_record_count",
    "invalid_record_count",
    "duplicate_record_count",
    "data_object",
    "checksum",
    "status",
    "processed_at"
  ],
  "properties": {
    "batch_id": { "type": "string" },
    "source_topic": { "type": "string" },
    "kafka_partition": { "type": "integer", "minimum": 0 },
    "first_offset": { "type": "integer", "minimum": 0 },
    "last_offset": { "type": "integer", "minimum": 0 },
    "record_count": { "type": "integer", "minimum": 0 },
    "valid_record_count": { "type": "integer", "minimum": 0 },
    "invalid_record_count": { "type": "integer", "minimum": 0 },
    "duplicate_record_count": { "type": "integer", "minimum": 0 },
    "data_object": { "type": "string" },
    "checksum": { "type": "string" },
    "status": { "type": "string", "enum": ["completed", "failed"] },
    "processed_at": { "type": "string", "format": "date-time" }
  }
}
